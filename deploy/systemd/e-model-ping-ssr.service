# Layanan SSR Inertia (Node 22+). Hanya mendengar 127.0.0.1:13714 — JANGAN dibuka ke internet.
# Pasang: sudo cp deploy/systemd/e-model-ping-ssr.service /etc/systemd/system/
#         sudo systemctl daemon-reload && sudo systemctl enable --now e-model-ping-ssr
[Unit]
Description=E-Model PING Inertia SSR
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/e-model-ping/current
ExecStart=/usr/bin/php artisan inertia:start-ssr
ExecStop=/usr/bin/php artisan inertia:stop-ssr --graceful
Restart=always
RestartSec=3
Environment=NODE_ENV=production
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
