APP_NAME="E-Model PING"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Domain kanonis tepercaya. Dipakai untuk canonical, sitemap, Open Graph, dan tautan reset sandi.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e_model_ping
DB_USERNAME=e_model_ping
DB_PASSWORD=

# Server personal tunggal: sesi & cache berbasis berkas, antrean sinkron (tanpa tabel sessions/cache/jobs).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produksi HTTPS: set true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Mailer lokal menulis surel ke storage/logs/laravel.log. Ganti ke smtp di produksi.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@emodelping.test"
MAIL_FROM_NAME="${APP_NAME}"

# Inertia SSR (proses Node lokal, jangan dibuka ke internet).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Bootstrap akun admin. Kosongkan sandi di lokal agar dibuat acak dan dicetak sekali di CLI.
# Di produksi WAJIB diisi sandi kuat (min. 12 karakter) lalu dihapus dari .env setelah akun dibuat.
ADMIN_AWAL_SUREL=admin@emodelping.test
ADMIN_AWAL_NAMA="Admin E-Model PING"
ADMIN_AWAL_SANDI=

# Batas keras unggahan (MB). Selaraskan dengan upload_max_filesize/post_max_size PHP dan client_max_body_size Nginx.
PING_BATAS_UNGGAH_MAKS_MB=25

# Isi hanya bila aplikasi berada di belakang proxy/load balancer tepercaya (mis. 127.0.0.1).
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
